    "Show Hidden Files": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli Dosyaları Göster"
          }
        }
      }
    },
    "Show Transfers": {
      "extractionState": "stale",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarımları Göster"
          }
        }
      }
    },
    "Sign In With": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş Yöntemi"
          }
        }
      }
    },
    "Signed in, but the server doesn't offer SFTP.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giriş yapıldı ama sunucu SFTP desteklemiyor."
          }
        }
      }
    },
    "Size": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyut"
          }
        }
      }
    },
    "Skip Existing": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Var Olanları Atla"
          }
        }
      }
    },
    "Test Connection": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı Test Et"
          }
        }
      }
    },
    "That bucket doesn't exist.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Böyle bir kova yok."
          }
        }
      }
    },
    "That bucket name is taken. Bucket names are shared by everyone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kova adı alınmış. Kova adları tüm kullanıcılar arasında tektir."
          }
        }
      }
    },
    "That's a public key. Choose the file without .pub.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir açık anahtar. Sonu .pub olmayan dosyayı seçin."
          }
        }
      }
    },
    "The access key ID or secret access key is incorrect.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim anahtarı kimliği veya gizli erişim anahtarı yanlış."
          }
        }
      }
    },
    "The bucket isn't empty.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kova boş değil."
          }
        }
      }
    },
    "The certificate of %@ couldn't be verified. Shared hosting often uses its own certificate; trust it only if you expect that.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sunucusunun sertifikası doğrulanamadı. Paylaşımlı hostingler çoğu zaman kendi sertifikasını kullanır; yalnızca bunu bekliyorsanız güvenin."
          }
        }
      }
    },
    "The connection was lost.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı koptu."
          }
        }
      }
    },
    "The file or folder no longer exists.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya ya da klasör artık yok."
          }
        }
      }
    },
    "The identity of %@ has changed. Someone may be intercepting the connection.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sunucusunun kimliği değişmiş. Bağlantınız başka biri tarafından dinleniyor olabilir."
          }
        }
      }
    },
    "The key's passphrase is incorrect.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar parolası yanlış."
          }
        }
      }
    },
    "The server didn't accept this RSA key. Newer servers refuse the RSA signature Pelican uses for now. Try an ed25519 key (ssh-keygen -t ed25519), and check that the public key is in authorized_keys.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bu RSA anahtarını kabul etmedi. Yeni sunucular, Pelican'ın şimdilik kullandığı RSA imzasını reddediyor. Bir ed25519 anahtarı deneyin (ssh-keygen -t ed25519) ve açık anahtarın authorized_keys dosyasında olduğunu kontrol edin."
          }
        }
      }
    },
    "The server didn't accept this key. Check that its public key is in authorized_keys.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bu anahtarı kabul etmedi. Açık anahtarın authorized_keys dosyasında olduğunu kontrol edin."
          }
        }
      }
    },
    "The server doesn't allow this here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu burada bu işleme izin vermiyor."
          }
        }
      }
    },
    "The server is out of space for this file.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuda bu dosya için yer kalmamış."
          }
        }
      }
    },
    "The server refused: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu reddetti: %@"
          }
        }
      }
    },
    "The user name or password is incorrect.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adı veya parola yanlış."
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac"
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem geri alınamaz."
          }
        }
      }
    },
    "This isn't an OpenSSH private key. Convert it with: ssh-keygen -p -f <key>": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir OpenSSH gizli anahtarı değil. Şu komutla dönüştürebilirsiniz: ssh-keygen -p -f <anahtar>"
          }
        }
      }
    },
    "This key can't list buckets. Enter a bucket name, for example /my-bucket.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtar kovaları listeleyemiyor. Kova alanına kova adını yazın, örneğin /kovam."
          }
        }
      }
    },
    "This key is protected. Enter its passphrase.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtar parola korumalı. Anahtar parolasını girin."
          }
        }
      }
    },
    "This key isn't allowed to do that.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtarın bu işlem için izni yok."
          }
        }
      }
    },
