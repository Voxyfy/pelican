        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH anahtarı desteği yakında geliyor"
          }
        }
      }
    },
    "SSH keys only work with SFTP. Use a password for FTP.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH anahtarı yalnızca SFTP ile çalışır. FTP için parola kullanın."
          }
        }
      }
    },
